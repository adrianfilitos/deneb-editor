{
  "name": "deneb-code-editor",
  "private": true,
  "version": "1.0.0",
  "description": "Deneb — Editor de código con IA (web + escritorio)",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianfilitos/deneb-editor.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:ext": "node scripts/run-ext-test.mjs",
    "test:ext:liveserver": "node scripts/run-ext-test.mjs live-server.ts",
    "test:ext:csharp": "node scripts/run-ext-test.mjs csharp.ts",
    "test:ext:debugger": "node scripts/run-ext-test.mjs debugger.ts",
    "test:ext:debugger-e2e": "node scripts/run-ext-test.mjs debugger-e2e.ts",
    "test:ext:debugger-cdp": "node scripts/run-ext-test.mjs debugger-cdp.ts",
    "test:ext:debugger-dap": "node scripts/run-ext-test.mjs debugger-dap.ts",
    "test:ext:lsp": "node scripts/run-ext-test.mjs lsp.ts",
    "test:ext:electron-ls": "node scripts/ext-test/electron-liveserver.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"cross-env DENEB_DEV=1 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:start": "cross-env DENEB_DEV=0 electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/ws": "^8.18.1",
    "electron-updater": "^6.8.9",
    "emmet-monaco-es": "^5.7.0",
    "fflate": "^0.8.3",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-protocol": "^3.18.2",
    "vscode-languageserver-textdocument": "^1.0.12",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.deneb.editor",
    "productName": "Deneb",
    "publish": {
      "provider": "github",
      "owner": "adrianfilitos",
      "repo": "deneb-editor"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "Deneb-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "deneb",
      "maintainer": "adrianfilitos <adrianfilitos@users.noreply.github.com>",
      "artifactName": "Deneb-${version}-linux.${ext}"
    },
    "dmg": {
      "artifactName": "Deneb-${version}-mac.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "warningsAsErrors": false,
      "artifactName": "Deneb-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Deneb-${version}.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@33.4.11": true
  }
}
